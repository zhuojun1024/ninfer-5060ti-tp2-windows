# Build
build/
build-*/
cmake-build-*/
*.o
*.obj
*.so
*.a
compile_commands.json
CMakeUserPresets.json
.cache/

# Python tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Raw third-party weight checkpoints (large; produced by offline tooling).
# Engine artifacts (*.ninfer) under out/ are tracked; raw checkpoints are not.
*.qus
*.bin
*.safetensors
*.gguf
/models/

# Local workspace and transient runtime output
/.local/
/_temp/
/temp/
/temp-*/
/tmp/
/tmp-*/
/AGENTS.override.md
/logs/
*.log
!profiles/**/*.log
*.tmp
/core
/core.*

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
.chatgpt/

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json
